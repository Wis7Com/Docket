# Build artifacts — fetched/regenerated locally, never committed.
# vendor/ holds the extracted LibreOffice tree (~1.5 GB) populated by
# scripts/fetch-libreoffice.js. backend/.dist-bundle/ is the staged
# backend (compiled JS + Electron-rebuilt native modules + prod
# node_modules) produced by scripts/stage-backend.js during npm run dist.
/vendor/
backend/.dist-bundle/

# Machine-local Docket runtime state (SQLite database and WAL files)
/backend/.docket-app/

# Native OCR helper compiled locally by scripts/build-vision-ocr.js
/native/macos-vision-ocr/docket-vision-ocr

# PDF standard fonts copied out of the pinned pdfjs-dist package by
# scripts/stage-pdf-standard-fonts.js before dev and build. Generated rather
# than committed so they cannot drift from the library that loads them.
/frontend/public/standard_fonts/
